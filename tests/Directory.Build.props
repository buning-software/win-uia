<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsUnitTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsUnitTestProject)' == 'true'">
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />

    <Using Include="NUnit.Framework" />

    <!-- UI Automation requires MTA; UI tests must not run in parallel (one desktop). -->
    <AssemblyAttribute Include="NUnit.Framework.ApartmentAttribute">
      <_Parameter1>System.Threading.ApartmentState.MTA</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.UiTests'))">
    <!-- UI tests are tagged so that a Category!=UI test filter skips them on a machine without an interactive desktop. -->
    <AssemblyAttribute Include="NUnit.Framework.CategoryAttribute">
      <_Parameter1>UI</_Parameter1>
    </AssemblyAttribute>

    <!-- One desktop: the lock is held for the whole test run of the assembly, across test processes. -->
    <Compile Include="$(MSBuildThisFileDirectory)DesktopLockSetUp.cs" Link="DesktopLockSetUp.cs" />
  </ItemGroup>
</Project>
