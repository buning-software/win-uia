<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Version comes from the publish workflow (release tag), not from here. -->
  <PropertyGroup>
    <Authors>Buning Software</Authors>
    <Company>Buning Software</Company>
    <Copyright>Copyright © Buning Software</Copyright>
    <PackageProjectUrl>https://github.com/buning-software/win-uia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/buning-software/win-uia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ui-automation;uia;uia3;windows;automation;testing;ui-testing;winforms;wpf;winui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>win-uia-logo.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- After the first release, set PackageValidationBaselineVersion to it so a binary-breaking change fails the pack. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../assets/win-uia-logo.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Every public member is listed in PublicAPI.Unshipped.txt (moved to PublicAPI.Shipped.txt at release), so a public API change shows up in review. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).IntegrationTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).UiTests" />
  </ItemGroup>
</Project>
