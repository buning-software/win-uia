<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>NUnit integration for WinUia: [UiTest], which gives each UI test the desktop to itself, and Eventually for asynchronous UI state.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lowest supported NUnit for package consumers, so it overrides the central version. -->
    <PackageReference Include="NUnit" VersionOverride="4.3.2" />
    <ProjectReference Include="..\WinUia.Core\WinUia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\WinUia.NUnit.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
